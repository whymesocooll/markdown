{
  "name": "inkflow",
  "version": "1.0.0",
  "private": true,
  "description": "InkFlow - A Typora-like WYSIWYG Markdown editor",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "desktop": "tauri dev",
    "pack": "tauri build && node scripts/pack-release.mjs",
    "smoke:desktop": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml && node test/desktop-smoke.mjs",
    "test:vault": "node test/vault.mjs",
    "test": "npm run build && node test/run.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "^2.12.4",
    "codemirror": "^6.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.2",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "puppeteer-core": "^25.5.0"
  }
}
